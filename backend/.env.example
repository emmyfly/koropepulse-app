# Comma-separated list of origins allowed to call this API (CORS).
# Defaults to "*" for local development.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Used by these features — none are required to run the rest of the API:
#  1. data/derive_real_data.py (reads driver check-in history to build real
#     retraining data)
#  2. POST /drivers/verify minting a Firebase custom token for the driver
#     (best-effort: response's custom_token is just null if this isn't set)
#  3. POST /drivers/verify-phone (SMS OTP identity check) — unlike #2, this
#     endpoint has no fallback and returns 503 if unset. Note it's required
#     here even though this endpoint never touches the Realtime Database
#     itself — the URL is bundled into one shared Firebase Admin app init.
# Copy the URL from frontend/.env.local (VITE_FIREBASE_DATABASE_URL).
FIREBASE_DATABASE_URL=https://koropepulse-e7512-default-rtdb.firebaseio.com

# Provide ONE of the following to authenticate as a Firebase service account.
# Generate one at Firebase Console > Project Settings > Service Accounts >
# Generate new private key. Never commit the downloaded key file.
#
# Full JSON key content as a single line (e.g. for a Railway/Vercel env var):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# Or a path to the downloaded key file (local dev):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/koropepulse-e7512-firebase-adminsdk.json
