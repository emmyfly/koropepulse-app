# Copy to .env.local and fill in with your Firebase project's web app config
# (Firebase console > Project settings > General > Your apps > SDK setup and config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the FastAPI backend (see /backend). Defaults to localhost:8000.
VITE_API_BASE_URL=http://localhost:8000

# Gates the SMS OTP driver sign-in path (Firebase Phone Auth) on top of the
# existing phone+PIN flow. Leave unset/false until BOTH of these are done,
# or every untrusted-device sign-in will make a real, currently-failing
# Firebase Phone Auth attempt before falling back to PIN:
#  1. Firebase console: enable the Phone sign-in provider (likely requires
#     upgrading to the Blaze pay-as-you-go plan for reCAPTCHA)
#  2. Railway: FIREBASE_SERVICE_ACCOUNT_JSON + FIREBASE_DATABASE_URL set on
#     the backend, so POST /drivers/verify-phone stops returning 503
# VITE_PHONE_AUTH_ENABLED=false
